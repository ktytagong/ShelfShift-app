# ShelfShift deploy configuration: the keys every deploy script reads (06-CONTEXT D-03, D-04, D-07, D-08).
#
# Copy this file to deploy/.env.local and replace every <placeholder> with the real value. deploy/.env.local is
# git-ignored and never enters the image or the Cloud Build upload; never commit it. Claude never reads it.
# Docs, plans and the runbook name these keys, never their values.
#
# Format: one key per line as KEY=value. No quotes, no spaces around '=', no 'export', no inline comments.
# Check a filled copy with: .venv/bin/python -m deploy.envfile check

# The demo Google Cloud project's ID (never the earlier personal project).
PROJECT=<demo-project-id>
# Region for Cloud Run, Cloud SQL and Artifact Registry.
REGION=asia-southeast1
# Gemini model ID (D-14); recorded in the release manifest, not passed to the service until Phase 9.
GEMINI_MODEL=gemini-3.5-flash
# Gemini endpoint location (D-14); global only when the model metadata check says the model is not served here.
VERTEX_LOCATION=asia-southeast1
# Billing account ID, used only to create the budget; it never reaches an image or a service (D-04).
BILLING_ACCOUNT=<billing-account-id>
# Contact address shown on the public paused page; may be left empty until Phase 11.
CONTACT_EMAIL=<contact-email-or-empty>
# Minimum Cloud Run instances, 0 or 1 (D-01): 0 now; the user sets 1 at submission until 2026-11-06. Max is always 1.
MIN_INSTANCES=0
# Daily AI requests across all sessions (D-12); it limits requests, not dollars (D-13).
GLOBAL_AI_CAP=300
# Display name of the monthly budget alert.
BUDGET_NAME=<budget-name>
# Monthly budget alert amount in US dollars, from the D-02 estimate; never written in a public artifact.
BUDGET_AMOUNT_USD=<monthly-budget-usd>
# Artifact Registry repository that holds the image.
AR_REPO=<artifact-registry-repo>
# Image name inside that repository.
IMAGE_NAME=<image-name>
# Cloud Run service name.
SERVICE=<cloud-run-service>
# Cloud Run job that migrates the database and builds the demo template (runs as the deploy service account).
BUILD_JOB=<build-job>
# Cloud Run job that runs the release bench gate against the template (runs as the runtime service account).
BENCH_JOB=<bench-job>
# Cloud Run job that runs the early bench on the frozen input, before the database exists (D-15).
EARLY_BENCH_JOB=<early-bench-job>
# Cloud SQL instance name (the instance only, not project:region:instance).
SQL_INSTANCE=<cloud-sql-instance>
# Database name inside the Cloud SQL instance.
DB_NAME=<database-name>
# Runtime service account email, <name>@<PROJECT>.iam.gserviceaccount.com for this PROJECT.
RUN_SA_EMAIL=<runtime-service-account-email>
# Deploy service account email (the build job and migrations), <name>@<PROJECT>.iam.gserviceaccount.com.
DEPLOY_SA_EMAIL=<deploy-service-account-email>
# Secret Manager secret that holds the demo passcode (the secret's name, never the passcode).
PASSCODE_SECRET=<passcode-secret-name>
# Secret Manager secret that holds the HQ passcode (the secret's name, never the passcode; 06.1 D-47).
HQ_PASSCODE_SECRET=<hq-passcode-secret-name>
# Private Cloud Storage bucket the release uploads the public dataset to; created by bash deploy/setup.sh data.
DATA_BUCKET=<release-data-bucket>
# Private Cloud Storage bucket for uploaded evidence; with GCP on the app refuses to start without it (11 H-3, H-4).
UPLOADS_BUCKET=<uploads-bucket>
# Folder holding the public set's manifest.json and parts/ for a release; empty builds data/reference as before.
RELEASE_DATA_DIR=
